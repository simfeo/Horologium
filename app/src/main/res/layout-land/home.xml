<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".ui.calendar.CalendarFragment">

    <ScrollView
        style="@style/Horo.Pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/horo_space_l"
        android:layout_weight="1">

        <LinearLayout style="@style/Horo.PaneContent">

            <DigitalClock
                android:id="@+id/digitalClock1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/Horo.Text.Display" />

            <TextView
                android:id="@+id/calendCurrentDate"
                style="@style/Horo.Fact"
                android:layout_marginTop="@dimen/horo_space_s" />

            <TextView android:id="@+id/calendCurrentWeekDay" style="@style/Horo.Fact" />
            <TextView android:id="@+id/calendCurrentWeekNumber" style="@style/Horo.Fact" />
            <TextView android:id="@+id/calendCurrentDayNumber" style="@style/Horo.Fact" />
            <TextView android:id="@+id/calendCurrentDayRemain" style="@style/Horo.Fact" />
        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <include
            android:id="@+id/calendarGrid"
            layout="@layout/calendar_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/horo_space_xs"
            app:layout_constraintBottom_toTopOf="@+id/calendarNav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/horo_calendar_max_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <include
            android:id="@+id/calendarNav"
            layout="@layout/calendar_month_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calendarGrid" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
