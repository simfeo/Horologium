<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".ui.moon.MoonFragment">

    <ScrollView
        style="@style/Horo.Pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/horo_space_l"
        android:layout_weight="1">

        <LinearLayout style="@style/Horo.PaneContent">

            <TextView android:id="@+id/moonFulllTime" style="@style/Horo.CenteredLine" />
            <TextView android:id="@+id/moonNullMoonTime" style="@style/Horo.CenteredLine" />

            <TextView
                android:id="@+id/moonMoonPhase"
                style="@style/Horo.CenteredLine"
                android:layout_marginTop="@dimen/horo_space_m" />

            <TextView android:id="@+id/moonVisibilityPercent" style="@style/Horo.CenteredLine" />

            <LinearLayout
                android:id="@+id/moonConstellation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/moonZodiacMoonPositionTitle" style="@style/Horo.Fact" />

                <TextView
                    android:id="@+id/moonZodiacMoonPositionName"
                    style="@style/Horo.Fact"
                    android:layout_marginStart="@dimen/horo_space_xs" />
            </LinearLayout>

            <TextView android:id="@+id/moonDistanceFromEarth" style="@style/Horo.CenteredLine" />
            <TextView android:id="@+id/moonAge" style="@style/Horo.CenteredLine" />
        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imageMoon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/MoonImageDescription"
            android:src="@drawable/clear_night"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/horo_image_max"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
