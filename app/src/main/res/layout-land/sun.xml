<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".ui.sun.SunFragment">

    <ScrollView
        style="@style/Horo.Pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/horo_space_l"
        android:layout_weight="1">

        <LinearLayout style="@style/Horo.PaneContent">

            <TextView
                android:id="@+id/sunCityName"
                style="@style/Horo.CenteredLine"
                android:textAppearance="@style/Horo.Text.Title" />

            <TextView
                android:id="@+id/sunGmtTimeZone"
                style="@style/Horo.CenteredLine"
                android:textAppearance="@style/Horo.Text.Secondary"
                android:textColor="@color/horo_text_secondary" />

            <TextView
                android:id="@+id/sunLatitude"
                style="@style/Horo.CenteredLine"
                android:layout_marginTop="@dimen/horo_space_s" />

            <TextView android:id="@+id/sunLongitude" style="@style/Horo.CenteredLine" />

            <TextView
                android:id="@+id/sunSunriseTime"
                style="@style/Horo.CenteredLine"
                android:layout_marginTop="@dimen/horo_space_m" />

            <TextView android:id="@+id/sunSunsetTime" style="@style/Horo.CenteredLine" />
            <TextView android:id="@+id/sunDayLength" style="@style/Horo.CenteredLine" />

            <Button
                android:id="@+id/sunOpenEditCoordsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/horo_space_m"
                android:text="@string/sun_editLocation_v1" />
        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imageSun"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/Sun_SunImageDescription_v1"
            android:src="@drawable/wb_twilight_sun"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/horo_image_max"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
