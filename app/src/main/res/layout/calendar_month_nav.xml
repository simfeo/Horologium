<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Button
        android:id="@+id/calendar_prev"
        android:layout_width="@dimen/horo_arrow_width"
        android:layout_height="@dimen/horo_arrow_height"
        android:background="@drawable/arrow_left"
        android:contentDescription="@string/calendar_PrevButton"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/emp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settedMon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/Horo.Text.Body" />

        <TextView
            android:id="@+id/settedYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/Horo.Text.Body" />
    </LinearLayout>

    <Button
        android:id="@+id/calendar_next"
        android:layout_width="@dimen/horo_arrow_width"
        android:layout_height="@dimen/horo_arrow_height"
        android:background="@drawable/arrow_right"
        android:contentDescription="@string/calendar_NextButton"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/emp" />
</LinearLayout>
