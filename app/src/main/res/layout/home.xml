<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Horo.Pane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.calendar.CalendarFragment">

    <!-- Packed vertical chain: the grid takes the spare height up to a cap, and the whole
         group is centred when the cap leaves room on tall screens. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <DigitalClock
            android:id="@+id/digitalClock1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/Horo.Text.Display"
            app:layout_constraintBottom_toTopOf="@+id/calendarInfoFlow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/calendarInfoFlow"
            style="@style/Horo.FactFlow"
            android:layout_marginTop="@dimen/horo_space_s"
            app:constraint_referenced_ids="calendCurrentDate,calendCurrentWeekDay,calendCurrentWeekNumber,calendCurrentDayNumber,calendCurrentDayRemain"
            app:layout_constraintBottom_toTopOf="@+id/calendarGrid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/digitalClock1" />

        <TextView android:id="@+id/calendCurrentDate" style="@style/Horo.Fact" />
        <TextView android:id="@+id/calendCurrentWeekDay" style="@style/Horo.Fact" />
        <TextView android:id="@+id/calendCurrentWeekNumber" style="@style/Horo.Fact" />
        <TextView android:id="@+id/calendCurrentDayNumber" style="@style/Horo.Fact" />
        <TextView android:id="@+id/calendCurrentDayRemain" style="@style/Horo.Fact" />

        <include
            android:id="@+id/calendarGrid"
            layout="@layout/calendar_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/horo_space_l"
            android:layout_marginBottom="@dimen/horo_space_s"
            app:layout_constraintBottom_toTopOf="@+id/calendarNav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/horo_calendar_max_height"
            app:layout_constraintHeight_min="240dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calendarInfoFlow" />

        <include
            android:id="@+id/calendarNav"
            layout="@layout/calendar_month_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calendarGrid" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
